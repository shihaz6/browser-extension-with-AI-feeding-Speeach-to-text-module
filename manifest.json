{
  "manifest_version": 3,
  "name": "Voice POS Order Entry (MVP)",
  "version": "0.1.0",
  "description": "Dictate products into a POS order and review them before entry.",
  "permissions": [],
  "host_permissions": ["http://*/*", "https://*/*", "http://localhost:3001/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["product-identity.js", "phonetic.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
